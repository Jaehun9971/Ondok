rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function room(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function isRoomMember(roomId) {
      return signedIn() && request.auth.uid in room(roomId).memberIds;
    }

    function validTodo() {
      return request.resource.data.keys().hasOnly([
          'text', 'targetMinutes', 'done', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200
        && request.resource.data.done is bool
        && (request.resource.data.targetMinutes == null
          || (request.resource.data.targetMinutes is int
            && request.resource.data.targetMinutes >= 0
            && request.resource.data.targetMinutes <= 1440));
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'nickname', 'photoURL', 'provider', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 20;
      allow delete: if false;

      match /todos/{todoId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && validTodo();
      }
    }

    match /rooms/{roomId} {
      allow read: if signedIn()
        && (resource.data.isPrivate == false
          || request.auth.uid in resource.data.memberIds);

      // 방과 참여자 수는 Callable Functions에서만 변경한다.
      allow create, update, delete: if false;

      match /members/{memberId} {
        allow read: if isRoomMember(roomId);
        allow create, update, delete: if false;
      }

      match /calls/{callId} {
        function validParticipants(data) {
          return data.participants is list
            && data.participants.size() == 2
            && request.auth.uid in data.participants
            && data.participants[0] in room(roomId).memberIds
            && data.participants[1] in room(roomId).memberIds;
        }

        allow create: if isRoomMember(roomId)
          && validParticipants(request.resource.data);
        allow read, update, delete: if isRoomMember(roomId)
          && request.auth.uid in resource.data.participants;

        match /{candidateCollection}/{candidateId} {
          allow read, write: if isRoomMember(roomId)
            && candidateCollection in ['offerCandidates', 'answerCandidates']
            && request.auth.uid in get(
              /databases/$(database)/documents/rooms/$(roomId)/calls/$(callId)
            ).data.participants;
        }
      }
    }

    // 초대 코드 해시 매핑은 Admin SDK 전용이다.
    match /roomInvites/{inviteHash} {
      allow read, write: if false;
    }
  }
}
